# Для локального запуска можно оставить это значение.
# На сервере замените его результатом: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Пустое значение закрывает регистрацию новых пользователей.
INVITE_CODE=

# Серверный блок (используется только в фазе деплоя):
